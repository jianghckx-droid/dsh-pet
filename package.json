{
  "name": "dsh-pet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A token-powered auto-battler that lives in the right sidebar.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node tools/run-tests.mjs",
    "test:node": "node --test",
    "build": "node tools/build-client.mjs",
    "build:check": "node tools/build-client.mjs --check",
    "sim": "node tools/balance-sim.mjs --sweep",
    "arena": "node tools/arena-report.mjs",
    "synergy": "node tools/synergy-report.mjs",
    "map": "node tools/map-report.mjs",
    "map:proto": "node tools/map-report.mjs --prototype",
    "preview": "node tools/render-frame.mjs 25 docs/preview.png 6 --demo",
    "preview:strip": "node tools/render-frame.mjs 25 docs/preview-strip.png 6 --demo --strip"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
